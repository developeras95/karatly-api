# =====================================================================================
# Karatly: settings for `docker compose --profile app up`
# =====================================================================================
#
# HOW TO USE
#   1. Copy this file to .env in the same folder:
#        Windows:      copy .env.example .env
#        macOS/Linux:  cp .env.example .env
#   2. Uncomment (remove the leading "# ") and fill in only the lines you need.
#   3. Restart:  docker compose --profile app up -d
#
# .env is ignored by git: it may hold passwords and API keys. Never commit it; commit this
# .env.example instead, with placeholders only.
#
# Running from IntelliJ instead of Docker? This file is not read there: set the same
# variables in Run > Edit Configurations > Environment variables.
# =====================================================================================

# ---- Ports on your computer ---------------------------------------------------------
# POSTGRES_PORT=5434
# APP_PORT=8081

# ---- Time zone that decides what "today" is ------------------------------------------
# KARATLY_TIME_ZONE=Asia/Kolkata

# ---- Metal rate provider (added in milestone M1) ---------------------------------------
# RATES_API_KEY=your-key-here
